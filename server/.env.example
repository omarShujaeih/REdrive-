PORT=5050
# MongoDB Atlas connection string. Leave empty to use an in-memory database with test data.
MONGO_URI=
JWT_SECRET=change-me
CLIENT_URL=http://localhost:5173
# Return OTP codes in API responses (development only)
SHOW_DEV_CODES=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Stripe test mode (sk_test_...). Leave empty to use the built-in payment simulation.
STRIPE_SECRET_KEY=
# Twilio SMS for OTP codes. Leave empty to print SMS in the server console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
